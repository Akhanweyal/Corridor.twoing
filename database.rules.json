{
  "rules": {
    "jobs": {
      // Declared here (not just on $jobId below) because the manager dashboard and
      // driver app fetch the whole /jobs.json list at once — a read rule nested only
      // under $jobId only ever applies when a specific job id is requested directly,
      // never to a list query, so it silently denied every dashboard/driver fetch.
      ".read": "auth != null",
      "$jobId": {
        // Anyone can submit a new service request (the public form isn't logged in),
        // but only as a brand-new pending job — never overwriting or reading an existing one.
        ".write": "auth != null || (!data.exists() && newData.child('status').val() === 'pending' && newData.child('customerName').isString() && newData.child('customerPhone').isString() && newData.child('feedbackToken').isString())",

        // The public feedback.html page can set these WITHOUT being signed in, but only
        // once, and only by proving it knows this job's feedbackToken via the _proof field.
        "feedbackSubmitted": {
          ".write": "auth != null || (data.exists() && data.val() === false && newData.val() === true && newData.parent().child('_proof').val() === data.parent().child('feedbackToken').val())"
        },
        "feedbackRating": {
          ".write": "auth != null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 5)"
        },
        "feedbackComment": {
          ".write": "auth != null || (newData.isString() && newData.val().length <= 1000)"
        },
        "feedbackAt": {
          ".write": "auth != null || newData.isNumber()"
        },
        "_proof": {
          ".write": "auth == null",
          ".validate": "newData.isString()"
        }
      }
    },

    "drivers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "driverLogs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // Deny everything else by default.
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
