{
  "rules": {
    // ---- Role model (RTDB rules have no variables, so every expression below is
    // repeated inline rather than named — the comments here are the source of truth) ----
    //
    // ADMIN  = signed in AND (the permanent bootstrap owner email, OR an /employees
    //          record with role:'admin' and active !== false). The bootstrap email is a
    //          permanent, unconditional admin — every other admin is created BY an admin
    //          (employees write is admin-only below), so there's always at least one way in.
    // DRIVER = signed in AND has an /employees record, active !== false, role !== 'admin'.
    //          A record with no role field at all still counts as a driver (every staff
    //          account created before roles existed has no role field) — no migration
    //          needed, "anything in /employees that isn't an admin" just means driver.
    // Anyone else authenticated (no /employees record at all) is a plain customer account
    // — self-registered through Firebase Auth, never approved by an admin, and with no
    // special read access anywhere below except their own /customers, /customerJobs and
    // the individual jobs those point at.
    //
    // Two lightweight index nodes make "a driver only ever sees their own jobs" and "a
    // customer only ever sees their own jobs" actually enforced by the database, not just
    // hidden in the app: /driverJobs/{uid}/{jobId} and /customerJobs/{uid}/{jobId} are
    // boolean pointers, admin-written (driver ones) or self-written-once (customer ones,
    // and only for a job that already names them). A list read of the top-level /jobs
    // node is admin-only; a driver/customer can still fetch one specific /jobs/{jobId}
    // because Firebase re-checks every rule from the root down to the exact path being
    // read, and the deeper per-job rule below grants that one id if it's in their index —
    // it just never grants the whole list.

    "jobs": {
      // Declared here (not just on $jobId below) because the manager dashboard fetches
      // the whole /jobs.json list at once — a read rule nested only under $jobId only
      // ever applies when a specific job id is requested directly, never to a list
      // query, so it silently denied every dashboard fetch. Drivers/customers never list
      // this node — they read their own ids one at a time via the $jobId rule below.
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      "$jobId": {
        ".read": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || (auth != null && root.child('employees').child(auth.uid).exists() && root.child('employees').child(auth.uid).child('active').val() !== false && root.child('employees').child(auth.uid).child('role').val() !== 'admin' && root.child('driverJobs').child(auth.uid).child($jobId).exists()) || (auth != null && root.child('customerJobs').child(auth.uid).child($jobId).exists())",
        // Anyone can submit a new service request (the public form isn't logged in),
        // but only as a brand-new pending job — never overwriting or reading an existing
        // one. If the requester happens to be signed in as a customer, the job may carry
        // their own uid (customerUid) so it later shows up in their account — but only
        // their OWN uid, never someone else's.
        ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (!data.exists() && newData.child('status').val() === 'pending' && newData.child('customerName').isString() && newData.child('customerName').val().length <= 100 && newData.child('customerPhone').isString() && newData.child('customerPhone').val().length <= 40 && newData.child('feedbackToken').isString() && (!newData.child('customerUid').exists() || (auth != null && newData.child('customerUid').val() === auth.uid)))",

        // The public feedback.html page can set these WITHOUT being signed in, but only
        // once, and only by proving it knows this job's feedbackToken via the _proof field.
        "feedbackSubmitted": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (data.exists() && data.val() === false && newData.val() === true && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('feedbackToken').val())"
        },
        "feedbackRating": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('feedbackToken').val() && data.parent().child('feedbackSubmitted').val() === false)"
        },
        "feedbackComment": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (newData.isString() && newData.val().length <= 1000 && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('feedbackToken').val() && data.parent().child('feedbackSubmitted').val() === false)"
        },
        "feedbackAt": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (newData.isNumber() && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('feedbackToken').val() && data.parent().child('feedbackSubmitted').val() === false)"
        },
        "_proof": {
          ".write": "auth == null",
          ".validate": "newData.isString()"
        }
      }
    },

    // Admin-written pointer: which jobs a given driver (by Firebase uid, not name — two
    // drivers can share a name, uids never collide) is assigned to. A driver can list
    // their own subtree (read at $uid) but can never write it themselves — assignment is
    // a dispatch action. See the block comment at the top of this file for why this is
    // what actually makes "drivers only see their own jobs" a database-enforced fact
    // instead of something the app merely chooses not to show.
    "driverJobs": {
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      "$uid": {
        ".read": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || auth.uid === $uid",
        "$jobId": {
          ".write": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    },

    // Same pattern as driverJobs, for a customer's own account. A customer account may
    // add a pointer to a job ONLY if that job already names them (customerUid, set at
    // creation time above) — so a customer can never point themselves at someone else's
    // job, and can never remove a pointer once set (no undo needed: the job doesn't go
    // away, and only an admin can restructure it).
    "customerJobs": {
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      "$uid": {
        ".read": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || auth.uid === $uid",
        "$jobId": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || (auth != null && auth.uid === $uid && !data.exists() && newData.isBoolean() && newData.val() === true && root.child('jobs').child($jobId).child('customerUid').val() === auth.uid)",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    },

    // Customer account profile (created client-side right after Firebase Auth sign-up).
    // Owner-only — never lists other customers, never readable by a driver.
    "customers": {
      "$uid": {
        ".read": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || auth.uid === $uid",
        ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || (auth != null && auth.uid === $uid)",
        ".validate": "newData.hasChild('email') && newData.child('email').isString() && newData.hasChild('createdAt') && newData.child('createdAt').isNumber()"
      }
    },

    // Short receipt links (receipt.html?r=xxxxxxxx instead of a long ?d=<base64 blob>
    // link). Read is scoped to $id only, not the "receiptLinks" node itself, so
    // knowing one short ID lets you read that one receipt but never lets anyone
    // list/dump every receipt ever created (same reasoning as the "jobs" comment
    // above about list-query reads vs. single-record reads).
    "receiptLinks": {
      "$id": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())"
      }
    },

    // Same pattern as receiptLinks above, for vehicle release-form links
    // (release-form.html?r=xxxxxxxx). List-level read (for the Business tab's revenue
    // aggregation) is admin-only — this is financial data with no legitimate driver use,
    // unlike jobs/driverLogs a driver has no "their own" slice of it to be granted. The
    // public single-record read below is unrelated and still unauthenticated.
    "releaseForms": {
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      "$id": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())",
        // The release-form page itself (not signed in) can save a signature —
        // draw or typed — WITHOUT being signed in, but only once, and only by
        // proving it knows this form's sigToken via the _proof field. Same
        // proof-token pattern as jobs/feedbackSubmitted above.
        "signatureDataUrl": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (!data.exists() && newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length <= 500000 && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('sigToken').val())"
        },
        "signatureTypedName": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (!data.exists() && newData.isString() && newData.val().length <= 100 && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('sigToken').val())"
        },
        "signatureMode": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (!data.exists() && (newData.val() === 'draw' || newData.val() === 'type') && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('sigToken').val())"
        },
        "signedAt": {
          ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (!data.exists() && newData.isNumber() && newData.parent().child('_proof').isString() && newData.parent().child('_proof').val() === data.parent().child('sigToken').val())"
        },
        "_proof": {
          ".write": "auth == null",
          ".validate": "newData.isString()"
        }
      }
    },

    // Live tracking record for the customer's map (track.html?t=TOKEN). Like receiptLinks,
    // read is scoped to ONE token so nobody can list every customer's trip; the token itself is
    // an unguessable random string and the record holds no name/phone/email. The public
    // request form may create the record once (pending, with a pickup point); after that only
    // staff can change it (assignment, status, live driver position).
    "tracking": {
      "$token": {
        ".read": true,
        ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || root.child('employees').child(auth.uid).exists())) || (!data.exists() && $token.length >= 16 && newData.child('status').val() === 'pending' && newData.child('pickup').child('lat').isNumber() && newData.child('pickup').child('lng').isNumber() && newData.child('pickup').child('address').isString() && newData.child('pickup').child('address').val().length <= 300 && (!newData.child('dest').exists() || (newData.child('dest').child('lat').isNumber() && newData.child('dest').child('lng').isNumber())) && !newData.child('driver').exists())"
      }
    },

    // Roster of driver contact records (name/phone/email/uid/active). Nothing in the
    // driver portal itself ever reads this node — only the admin Drivers tab does — so
    // it's admin-only both ways now (previously any signed-in driver could read AND
    // WRITE every other driver's roster entry, including deleting one).
    "drivers": {
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      ".write": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))"
    },

    // Time-clock check-in/out records, keyed by driver uid. The Time Logs dashboard
    // (admin only) needs a blanket read to total everyone's hours; each driver needs
    // read+write of ONLY their own subtree (their check-in app already scopes every
    // request to their own uid — this just makes that the enforced floor instead of the
    // ceiling). Previously the blanket rule let any signed-in driver read AND edit every
    // other driver's hours; that's now admin-only, with the owner still allowed in.
    "driverLogs": {
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      ".write": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      "$uid": {
        ".read": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || auth.uid === $uid",
        ".write": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || auth.uid === $uid"
      }
    },

    // Staff approval list: {email, role:'admin'|'driver', active, mustChangePassword,
    // createdAt}. Only an admin can add/remove/edit an entry — there is no public path
    // to grant yourself staff access, self-registration only ever reaches /customers
    // below. Each employee can also read their OWN record (needed to look up their own
    // role/mustChangePassword flag on sign-in) and clear their own mustChangePassword
    // flag once they've set a real password — nothing else about their own record, and
    // nothing at all about anyone else's.
    "employees": {
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      ".write": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      "$uid": {
        ".read": "(auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || auth.uid === $uid",
        "mustChangePassword": {
          ".write": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false) || auth.uid === $uid)"
        }
      }
    },

    // Append-only record of significant staff actions (sign-ins, job cancel/delete,
    // driver assign/unassign, employee created/disabled/enabled) for accountability.
    // Any active staff member can add ONE new entry stamped with their own uid — never
    // edit or delete an existing one, and never claim to be someone else. Only an admin
    // can read the log back.
    "auditLog": {
      ".read": "auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))",
      "$entryId": {
        ".write": "!data.exists() && ((auth != null && (auth.token.email === 'ajmal@corridortowing.org' || (root.child('employees').child(auth.uid).child('role').val() === 'admin' && root.child('employees').child(auth.uid).child('active').val() !== false))) || (auth != null && root.child('employees').child(auth.uid).exists() && root.child('employees').child(auth.uid).child('active').val() !== false && root.child('employees').child(auth.uid).child('role').val() !== 'admin')) && newData.child('actorUid').val() === auth.uid && newData.child('at').isNumber() && newData.child('action').isString() && newData.child('action').val().length <= 60"
      }
    },

    // Deny everything else by default.
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
